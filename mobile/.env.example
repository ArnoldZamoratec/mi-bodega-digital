# Configuración del proyecto Firebase (consola de Firebase → Configuración del proyecto → Tus apps → Web).
# Estos valores identifican el proyecto; la seguridad real la dan las reglas de Firestore.
# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Debe coincidir con la constante appId de la web (js/firebase.js) para compartir datos.
FIREBASE_DATA_APP_ID=mi-bodega-app

# Identificadores de la app nativa
APP_ANDROID_PACKAGE=com.arnoldcode.mibodega
APP_IOS_BUNDLE_ID=com.arnoldcode.mibodega

# Opcional: ID de proyecto EAS (lo genera `eas init`)
EAS_PROJECT_ID=

# Opcional: inicio de sesión con Google. Firebase → Authentication → Método de acceso →
# Google → Configuración del SDK web → "ID de cliente web". Vacío = el botón no aparece.
GOOGLE_WEB_CLIENT_ID=
# Opcional, solo iOS: REVERSED_CLIENT_ID del cliente OAuth de iOS.
GOOGLE_IOS_URL_SCHEME=
