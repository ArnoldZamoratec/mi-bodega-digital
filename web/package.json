{
  "name": "web",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Bodegón Digital — app web (Vite + TypeScript) servida por Firebase Hosting desde web/dist.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
